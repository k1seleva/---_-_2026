DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# База: по умолчанию SQLite. Для PostgreSQL:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=sm_clinic
# DB_USER=sm
# DB_PASSWORD=sm
# DB_HOST=db
# DB_PORT=5432

# Celery: 1 — задачи синхронно (демо без Redis); 0 — через брокер
CELERY_TASK_ALWAYS_EAGER=1
# CELERY_BROKER_URL=redis://redis:6379/0
# EVENT_BUS_BACKEND=celery

# ИИ-агент (Qwen): разметка и находки делают вместе словарь и модель; none — только словарь.
# Проверка подключения: python manage.py check_llm
#
# Qwen через Ollama на этом же компьютере (имя модели как в `ollama list`):
#   LLM_PROVIDER=ollama
#   LLM_MODEL=qwen2.5:14b
#   LLM_BASE_URL=http://localhost:11434
#   (приложение в docker compose, Ollama на компьютере: LLM_BASE_URL=http://host.docker.internal:11434)
# Qwen через LM Studio, vLLM или другой OpenAI-совместимый сервер (pip install langchain-openai):
#   LLM_PROVIDER=openai
#   LLM_MODEL=qwen2.5-14b-instruct
#   LLM_BASE_URL=http://localhost:1234/v1
LLM_PROVIDER=none
LLM_MODEL=
LLM_BASE_URL=
# Окно контекста Ollama в токенах: у Ollama по умолчанию 2–4 тыс., длинный протокол молча обрезается
LLM_NUM_CTX=8192
# Сколько ждать ответа модели, секунд (на CPU 14B отвечает долго)
LLM_TIMEOUT_SEC=180
# Qwen3: 0 — без «размышлений» (быстрее, для разметки протоколов рекомендуется), 1 — с ними; пусто — как в модели
LLM_REASONING=
# Предел длины ответа в токенах (при LLM_REASONING=0 по умолчанию 2048; 0 — без предела)
LLM_NUM_PREDICT=
# Сколько Ollama держит модель в памяти между протоколами
LLM_KEEP_ALIVE=30m
# 2 — находки и разметка запрашиваются одновременно (только если на сервере Ollama OLLAMA_NUM_PARALLEL>=2)
LLM_PARALLEL_CALLS=1
# Модель не ответила: пауза в секундах, затем пробный запрос; очередь ждёт модель не дольше LLM_WAIT_MINUTES
LLM_COOLDOWN_SEC=60
LLM_WAIT_MINUTES=10

# Очередь разбора протоколов: thread (фоновый поток сайта, по умолчанию без Redis) | celery | sync (отладка)
# PROCESSING_QUEUE=
# Сколько протоколов разбирать одновременно (не больше, чем тянет сервер модели)
PROCESSING_WORKERS=1
# Задача «в работе» дольше стольких минут считается зависшей и возвращается в очередь (до 2 попыток)
PROCESSING_STALE_MINUTES=20
# OPENAI_API_KEY= / ANTHROPIC_API_KEY= / GIGACHAT_CREDENTIALS=

# Подпись вебхука МИС (HMAC-SHA256 в заголовке X-MIS-Signature)
MIS_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://localhost:8000

# Советы ИИ-агента по маршрутизации: auto | qwen | demo | off (подробно в config/settings.py).
# auto: задан LLM_PROVIDER — отвечает Qwen (та же модель, что у разметки); не задан — демо-режим с пометкой.
ROUTING_ADVISOR_MODE=auto
# Другая модель или сервер только для советов:
# ROUTING_ADVISOR_PROVIDER=ollama
# ROUTING_ADVISOR_MODEL=qwen2.5:14b
# ROUTING_ADVISOR_BASE_URL=http://localhost:11434

# Вход координатора и врача: пароль демо-сотрудников из seed_demo и подсказка на странице входа (только для стенда)
STAFF_DEMO_PASSWORD=demo-2026
STAFF_DEMO_HINT=1

# Вход пациента: пароль демо-пациентов из seed_demo и подсказка на странице входа (только для стенда)
PATIENT_DEMO_PASSWORD=demo-2026
PATIENT_DEMO_HINT=1
